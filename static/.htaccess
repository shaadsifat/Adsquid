# Adsquid - Apache / cPanel config (redirects, caching, compression, 404)

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One canonical domain: https://adsquidbd.com (single redirect, no chains)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://adsquidbd.com%{REQUEST_URI} [L,R=301]

  # Old site URLs -> new pages (add more as you find them in Search Console)
  RewriteRule ^portfolio-details/?$ /work/ [L,R=301]
  RewriteRule ^portfolio/?$ /work/ [L,R=301]
  RewriteRule ^about-us/?$ /about/ [L,R=301]
  RewriteRule ^contact-us/?$ /contact/ [L,R=301]
  # Service slugs renamed in the 2026 service lineup (eight services)
  RewriteRule ^services/digital-ads-management/?$ /services/ads-campaign/ [L,R=301]
  RewriteRule ^services/digital-ads-management/(.+)$ /services/ads-campaign/$1 [L,R=301]
  RewriteRule ^services/social-media-management/?$ /services/social-media-marketing/ [L,R=301]
  RewriteRule ^services/content-development/?$ /services/video-production/ [L,R=301]
  RewriteRule ^blog/category/digital-ads-management/?$ /blog/category/ads-campaign/ [L,R=301]
  RewriteRule ^blog/category/social-media-management/?$ /blog/category/social-media-marketing/ [L,R=301]
  RewriteRule ^blog/category/content-development/?$ /blog/category/video-production/ [L,R=301]
  # Sample case-study pages replaced by the portfolio gallery
  RewriteRule ^work/.+$ /work/ [L,R=301]

  # /index.html and /folder/index.html -> clean URL (only for real browser requests, not internal ones)
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301]

  # Trailing slash for folder URLs (/seo -> /seo/)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ /$1/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # HTML: short cache. Assets: 1 year (CSS/JS are versioned with ?v=hash by the build)
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff2|webp|avif|jpg|jpeg|png|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webmanifest|xml|txt)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript text/javascript image/svg+xml application/json application/manifest+json text/xml application/xml text/plain
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json application/manifest+json text/xml application/xml text/plain
</IfModule>
